# Azure AI Foundry project endpoint, e.g.
# https://<your-project>.services.ai.azure.com/api/projects/<project-name>
PROJECT_ENDPOINT=

# Name of a model deployment in that project (e.g. gpt-4o)
MODEL_DEPLOYMENT_NAME=

# Optional
AGENT_NAME=long-running-agent
AGENT_INSTRUCTIONS=You are a helpful assistant that completes background tasks submitted to you one at a time. Be concise.
POLL_INTERVAL_SECONDS=1

# Strongly recommended once this is exposed publicly — gates POST
# /jobs, POST /conversations, and GET /jobs/{id} behind a bearer
# token. Leave unset for local testing only.
API_TOKEN=
